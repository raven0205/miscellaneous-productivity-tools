# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=local
DEBUG=true
PROJECT_NAME="AI E-commerce Marketing Autopilot"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_dev_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Database Configuration (Docker Compose Defaults)
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=autopilot_user
POSTGRES_PASSWORD=autopilot_pass
POSTGRES_DB=autopilot_db

# ==========================================
# Business Rules & Threshold Defaults
# ==========================================
ABANDONMENT_THRESHOLD_HOURS=1
POLLING_INTERVAL_SECONDS=60
FREQUENCY_CAP_PER_DAY=1
MAX_DISCOUNT_PERCENT=5.0

# ==========================================
# External Integrations (Safe Local Defaults)
# ==========================================
# Keep LLM disabled by default (FR-09 fallback mode)
ENABLE_LLM=false
OPENAI_API_KEY=""

# Simulate email sends locally without real delivery providers (FR-10)
SIMULATE_EMAIL_DELIVERY=true